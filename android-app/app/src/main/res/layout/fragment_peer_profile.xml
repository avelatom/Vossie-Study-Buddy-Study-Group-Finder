<?xml version="1.0" encoding="utf-8"?>
<!-- FR09 / FR10 / FR16 - another student's profile -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/peer_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_avatar_ring"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/peer_avatar"
                        style="@style/Widget.V2V.Avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textSize="30sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/peer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/peer_campus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:drawableStart="@drawable/ic_location_small"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/v2v_on_navy_muted"
                    android:gravity="center_vertical"
                    android:textColor="@color/v2v_on_navy_muted" />

                <!-- Average rating (FR16) -->
                <TextView
                    android:id="@+id/peer_rating"
                    style="@style/Widget.V2V.Chip"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/v2v_blue"
                    android:textColor="@color/white"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Private / connections only -->
            <TextView
                android:id="@+id/peer_limited"
                style="@style/Widget.V2V.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:drawableStart="@drawable/ic_lock"
                android:drawableTint="@color/v2v_navy"
                android:gravity="center_vertical"
                android:text="This student has limited who can see their profile. Connect to see more."
                android:visibility="gone" />

            <!-- ABOUT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/peer_about_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.V2V.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="About" />

                    <TextView
                        android:id="@+id/peer_bio"
                        style="@style/TextAppearance.V2V.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MODULES -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/peer_skills_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/peer_skills_title"
                        style="@style/TextAppearance.V2V.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modules" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/peer_skills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BUTTONS (set in code) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp">

                <!-- Connect / Accept / Message -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/peer_button_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- Decline (only for requests I got) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/peer_button_secondary"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Decline"
                    android:visibility="gone" />

                <!-- FR16 - only when connected -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/peer_button_feedback"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Give feedback"
                    android:visibility="gone"
                    app:icon="@drawable/ic_star" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/peer_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true" />
</FrameLayout>
