<?xml version="1.0" encoding="utf-8"?>
<!-- One student on the Connections tab -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/conn_item_avatar"
                style="@style/Widget.V2V.Avatar"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/conn_item_name"
                    style="@style/TextAppearance.V2V.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/conn_item_campus"
                    style="@style/TextAppearance.V2V.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_location_small"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/v2v_grey"
                    android:gravity="center_vertical" />
            </LinearLayout>

            <!-- Pending (requests I sent) -->
            <TextView
                android:id="@+id/conn_item_status"
                style="@style/Widget.V2V.Chip"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

            <!-- Message (connected) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/conn_item_message"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Message"
                android:visibility="gone"
                app:icon="@drawable/ic_chat"
                app:iconTint="@color/v2v_navy" />
        </LinearLayout>

        <!-- Accept / Decline (requests I got) -->
        <LinearLayout
            android:id="@+id/conn_item_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/conn_item_accept"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Accept" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/conn_item_decline"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Decline" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
