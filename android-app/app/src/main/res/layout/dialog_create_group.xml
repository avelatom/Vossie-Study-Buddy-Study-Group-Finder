<?xml version="1.0" encoding="utf-8"?>
<!-- FR11 - new study group dialog -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.V2V.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Group name (3-50 characters)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dlg_group_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLength="50" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/TextAppearance.V2V.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="Module" />

        <Spinner
            android:id="@+id/dlg_group_module"
            style="@style/Widget.V2V.SpinnerBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.V2V.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Topic / description (optional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dlg_group_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="255"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.V2V.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Maximum members (2-30)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dlg_group_max"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="2"
                android:text="5" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
