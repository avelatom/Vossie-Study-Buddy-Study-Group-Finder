<?xml version="1.0" encoding="utf-8"?>
<!-- FR04 / FR05 / FR06 - my modules and skills -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ADD A MODULE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.V2V.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add a module" />

                <TextView
                    style="@style/TextAppearance.V2V.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Matches are based on these lists." />

                <Spinner
                    android:id="@+id/skills_module"
                    style="@style/Widget.V2V.SpinnerBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <!-- Which list (FR04 / FR05 / FR06) -->
                <RadioGroup
                    android:id="@+id/skills_type_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/skills_type_studying"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="I am studying this module" />

                    <RadioButton
                        android:id="@+id/skills_type_offering"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="I can help others with this module" />

                    <RadioButton
                        android:id="@+id/skills_type_requiring"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="I need help with this module" />
                </RadioGroup>

                <!-- Only for "I can help others" -->
                <TextView
                    android:id="@+id/skills_level_label"
                    style="@style/TextAppearance.V2V.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:text="How well do you know it?"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/skills_level"
                    style="@style/Widget.V2V.SpinnerBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/skills_add_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Add module"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- MY MODULES -->
        <TextView
            style="@style/TextAppearance.V2V.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="20dp"
            android:text="My modules" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/skills_empty"
                    style="@style/TextAppearance.V2V.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="You have not added any modules yet."
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/skills_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/skills_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:trackCornerRadius="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
