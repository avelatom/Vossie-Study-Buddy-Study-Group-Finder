<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Styles for cards, buttons, text fields etc. Most get applied through the theme -->

    <!-- CARDS -->
    <style name="Widget.V2V.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- BUTTONS -->
    <style name="Widget.V2V.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="iconGravity">textStart</item>         
    </style>

    <style name="Widget.V2V.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="iconGravity">textStart</item>
        <item name="strokeColor">@color/v2v_navy</item>
        <item name="android:textColor">@color/v2v_navy</item>
        <item name="iconTint">@color/v2v_navy</item>
    </style>

    <style name="Widget.V2V.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- List style button with an icon (profile screen) -->
    <style name="Widget.V2V.Button.Row" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">@color/v2v_text</item>
        <item name="iconTint">@color/v2v_navy</item>
        <item name="iconPadding">16dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- TEXT FIELDS -->
    <style name="Widget.V2V.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/v2v_navy</item>
        <item name="hintTextColor">@color/v2v_navy</item>
        <item name="startIconTint">@color/v2v_grey</item>
    </style>

    <!-- Box around spinners so they match the text fields -->
    <style name="Widget.V2V.SpinnerBox" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="Widget.V2V.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/v2v_navy</item>
        <item name="android:textColor">@color/v2v_text</item>
    </style>

    <style name="Widget.V2V.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/v2v_navy</item>
        <item name="android:textColor">@color/v2v_text</item>
    </style>

    <!-- BOTTOM BAR -->
    <style name="Widget.V2V.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/white</item>
        <item name="backgroundTint">@color/white</item>
        <item name="elevation">8dp</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.V2V.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.V2V.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/v2v_light</item>
    </style>

    <!-- DIALOGS -->
    <style name="ThemeOverlay.V2V.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/v2v_navy</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="textInputStyle">@style/Widget.V2V.TextInput</item>
    </style>

    <!-- TEXT STYLES -->
    <!-- Toolbar title -->
    <style name="TextAppearance.V2V.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Big headings -->
    <style name="TextAppearance.V2V.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/v2v_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Card titles / names -->
    <style name="TextAppearance.V2V.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/v2v_navy</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small section labels -->
    <style name="TextAppearance.V2V.Section" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/v2v_grey</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.V2V.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/v2v_text</item>
    </style>

    <style name="TextAppearance.V2V.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/v2v_grey</item>
    </style>

    <!-- OTHER -->
    <!-- Chips -->
    <style name="Widget.V2V.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/v2v_navy_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Initials avatar (colour set in Avatar.java) -->
    <style name="Widget.V2V.Avatar" parent="">
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Info box -->
    <style name="Widget.V2V.Notice" parent="">
        <item name="android:background">@drawable/bg_notice</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/v2v_navy_dark</item>
        <item name="android:drawablePadding">10dp</item>
    </style>

    <!-- Empty list message -->
    <style name="Widget.V2V.EmptyState" parent="">
        <item name="android:gravity">center</item>
        <item name="android:padding">32dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textColor">@color/v2v_grey</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
</resources>
